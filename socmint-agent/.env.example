# Local ADK development with Google AI Studio.
# Never commit the real key.
GEMINI_API_KEY=

# The agent deliberately does NOT depend on Gemini Google Search grounding.
SOCMINT_AGENT_MODEL=gemini-3.5-flash-lite

# Optional external discovery provider. Production uses brave.
# disabled | searxng | brave
SOCMINT_SEARCH_PROVIDER=disabled

# For SearXNG:
SOCMINT_SEARCH_BASE_URL=

# For Brave Search:
BRAVE_SEARCH_API_KEY=

# Must equal the Worker's SOCMINT_AGENT_SHARED_SECRET.
CT_ATLAS_AGENT_SHARED_SECRET=

# Local-only convenience. Do not use in Cloud Run.
SOCMINT_AGENT_ALLOW_INSECURE_LOCAL=1

# Optional free/public social-source collectors.
# Bluesky and basic Mastodon discovery require no key.
YOUTUBE_API_KEY=

# X and Reddit stay off without the platform's written approval, whatever keys are
# set here. Set the flag only once that approval is on file (see README).
X_BEARER_TOKEN=
X_WRITTEN_APPROVAL=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CT-Atlas-SOCMINT-Agent/0.1
REDDIT_WRITTEN_APPROVAL=

# Optional Groq free-tier Whisper transcription.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional zero-cost preprocessing of already-public text.
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
