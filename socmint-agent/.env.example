# Local ADK development with Google AI Studio.
# Never commit the real key.
GEMINI_API_KEY=

# The agent deliberately does NOT depend on Gemini Google Search grounding.
SOCMINT_AGENT_MODEL=gemini-2.5-flash-lite

# Optional external discovery provider.
# disabled | searxng | brave
SOCMINT_SEARCH_PROVIDER=disabled

# For SearXNG:
SOCMINT_SEARCH_BASE_URL=

# For Brave Search:
BRAVE_SEARCH_API_KEY=

# Optional shared secret if the agent is exposed behind a custom proxy.
CT_ATLAS_AGENT_SHARED_SECRET=

# Local-only convenience. Do not use in Cloud Run.
SOCMINT_AGENT_ALLOW_INSECURE_LOCAL=1

# Optional free/public social-source collectors.
# Bluesky and basic Mastodon discovery require no key.
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CT-Atlas-SOCMINT-Agent/0.1

# Optional Groq free-tier Whisper transcription.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
