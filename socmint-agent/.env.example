# Local ADK development with Google AI Studio.
# Never commit the real key.
GEMINI_API_KEY=

# The agent deliberately does NOT depend on Gemini Google Search grounding.
SOCMINT_AGENT_MODEL=gemini-2.5-flash-lite

# Optional external discovery provider.
# disabled | searxng | brave
SOCMINT_SEARCH_PROVIDER=disabled

# For SearXNG:
SOCMINT_SEARCH_BASE_URL=

# For Brave Search:
BRAVE_SEARCH_API_KEY=

# Optional shared secret if the agent is exposed behind a custom proxy.
CT_ATLAS_AGENT_SHARED_SECRET=
