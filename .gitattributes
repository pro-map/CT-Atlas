# Text is stored with LF and checked out with LF on every machine, whatever
# core.autocrlf says. A file already committed with CR keeps its bytes (the
# text=auto rule) until someone runs git add --renormalize on it. Do not run
# that repo-wide: index.html rewritten whole would conflict with every agent.
* text=auto eol=lf

# Never text, whatever the content looks like.
*.png  binary
*.jpg  binary

# The monthly database store (docs/STORAGE_MIGRATION.md): LF on every machine,
# or the seals in data/events/meta.json no longer match the files.
data/events/** text eol=lf
