# Local build staging for the ct-atlas-mirror Cloudflare Worker deploy --
# regenerated from the tracked root files before each mirror redeploy, never
# itself a source of truth.
_pages_mirror/
.wrangler/
__pycache__/
*.pyc
.env
.env.*
!.env.example
events-lite.json
events-map.json
# Local UI test harness pages (stubbed session, embedded database): never
# committed or published.
zz-*.html
# Local Claude Code permissions of this machine.
.claude/settings.local.json

# Outlet addresses, collector state and original evidence remain local/private.
private-outlet-watch/
*.sqlite

# Which data/events/ build a local events.json came from (events_store.py).
/events.json.store-base
